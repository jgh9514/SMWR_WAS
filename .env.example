# Grafana Cloud OTLP 인증 헤더 (메트릭·로그·트레이스 수집)
# 형식: Basic base64(userId:glc_token)
# Grafana Cloud → Connections → OpenTelemetry 에서 복사
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64_encoded_userid:token>

# Grafana iframe 프록시 (관리자 /admin/monitoring — Service Account glsa, 프론트에는 두지 않음)
# Cloud Portal → Stacks → Grafana URL. Prometheus username(2489437)과 다름
SMW_GRAFANA_CLOUD_BASE_URL=https://sjrtjr3150.grafana.net
SMW_GRAFANA_CLOUD_ENABLED=true
SMW_GRAFANA_CLOUD_ACCESS_TOKEN=glsa_<your-access-policy-token>

# 대시보드 uid (선택 — 미설정 시 Grafana search API로 자동 탐색)
# SMW_GRAFANA_DASHBOARD_WAS_UID=
# SMW_GRAFANA_DASHBOARD_BATCH_UID=
