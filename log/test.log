2026-02-14 20:04:55.348 [http-nio-8080-exec-4] DEBUG com.smw.account.mapper.AccountSummaryMapper.selectMonsterCatalog - ==>  Preparing: /* selectMonsterCatalog */ WITH owned AS ( -- 보유 몬스터는 (노각성/각성)을 각성 버전(com2us_id)으로 매핑해서 합산 카운트 SELECT COALESCE(m.awakens_to_id, m.com2us_id) AS awakened_com2us_id ,COUNT(*) AS owned_count FROM swex_monster sm JOIN swex_account_import si ON si.import_id = sm.import_id AND si.user_id = ? JOIN public.monster m ON m.com2us_id = sm.master_id WHERE sm.import_id = CAST(? AS BIGINT) GROUP BY COALESCE(m.awakens_to_id, m.com2us_id) ) SELECT m.monster_id ,m.com2us_id ,m.monster_elemental ,m.kr_name ,m.un_name ,m.image_url ,COALESCE(o.owned_count, 0) AS owned_count FROM public.monster m LEFT JOIN owned o ON o.awakened_com2us_id = m.com2us_id WHERE 1=1 -- 각성 버전만 노출 (노각성은 제외) AND m.awakens_to_id IS NULL -- 사용(획득) 가능한 몬스터만 노출 (usg_yn 개념) AND COALESCE(m.obtainable, true) = true AND LOWER(m.monster_elemental) = LOWER(?) -- 정렬: 2각(awaken_level=2) 우선 → 별(자연별/기본별/별) → com2us_id ORDER BY CASE WHEN COALESCE(m.awaken_level, 0) >= 2 THEN 0 ELSE 1 END ASC, COALESCE(m.natural_stars, m.base_stars, m.star) DESC NULLS LAST, COALESCE(m.base_stars, m.star) DESC NULLS LAST, m.star DESC, m.com2us_id ASC NULLS LAST LIMIT CAST(? AS INTEGER) OFFSET CAST(? AS INTEGER)
