<?xml version="1.0" encoding="UTF-8"?>
<!-- Spring Boot: log4j2-spring.xml 우선 로드 (프로필별 Spring 확장 사용 가능) -->
<Configuration status="WARN" packages="com.sysconf.logging">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} [%X{traceId}] - %msg%n</Property>
        <Property name="LOG_FILE_PATH">${sys:user.dir}/log/test.log</Property>
        <!-- SQL 로그: log4jdbc → SLF4J → Log4j2. 기본은 application.yml jdbc.sqltiming(INFO)과 맞춤. 필요 시 -DSQL_LOG_LEVEL=DEBUG -->
        <Property name="SQL_LOG_LEVEL">${sys:SQL_LOG_LEVEL:-INFO}</Property>
    </Properties>
    
    <Appenders>
        <Console name="ConsoleRaw" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
        <Rewrite name="Console" rewritePolicy="Truncate">
            <AppenderRef ref="ConsoleRaw"/>
        </Rewrite>
        
        <RollingFile name="FileAppenderRaw" fileName="${LOG_FILE_PATH}"
                     filePattern="${LOG_FILE_PATH}.%d{yyyy-MM-dd}-%i.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
        <Rewrite name="FileAppender" rewritePolicy="Truncate">
            <AppenderRef ref="FileAppenderRaw"/>
        </Rewrite>
        
        <RollingFile name="SqlAppenderRaw" fileName="${sys:user.dir}/log/sql.log"
                     filePattern="${sys:user.dir}/log/sql.log.%d{yyyy-MM-dd}-%i.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
        <Rewrite name="SqlAppender" rewritePolicy="Truncate">
            <AppenderRef ref="SqlAppenderRaw"/>
        </Rewrite>
    </Appenders>
    
    <Loggers>
        <Root level="INFO">
            <OtelExportSizeCapFilter maxBytes="204800" onMatch="DENY" onMismatch="NEUTRAL"/>
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Root>
        
        <Logger name="org.springframework" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="org.springframework.web" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="org.springframework.orm" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="org.springframework.transaction" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="org.springframework.security" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        
        <Logger name="com.smw" level="DEBUG" additivity="false">
            <OtelExportSizeCapFilter maxBytes="204800" onMatch="DENY" onMismatch="NEUTRAL"/>
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="com.smw.guild.mapper" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="com.cf" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="com.admin" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="com.sysconf" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        
        <Logger name="com.sysconf.interceptor" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <Logger name="com.sysconf.interceptor.MybatisInterceptor" level="INFO" additivity="false">
            <OtelExportSizeCapFilter maxBytes="204800" onMatch="DENY" onMismatch="NEUTRAL"/>
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="SqlAppender"/>
        </Logger>

        <Logger name="org.apache.ibatis" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        
        <Logger name="jdbc.sqlonly" level="${SQL_LOG_LEVEL}" additivity="false">
            <OtelExportSizeCapFilter maxBytes="204800" onMatch="DENY" onMismatch="NEUTRAL"/>
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SqlAppender"/>
        </Logger>
        <Logger name="jdbc.sqltiming" level="${SQL_LOG_LEVEL}" additivity="false">
            <OtelExportSizeCapFilter maxBytes="204800" onMatch="DENY" onMismatch="NEUTRAL"/>
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SqlAppender"/>
        </Logger>
        <!-- INFO 시 ResultSet.getInt/next 등 행 단위 스파이 로그 폭주 — SQL 문·시간은 jdbc.sqltiming -->
        <Logger name="log4jdbc.log4j2" level="WARN" additivity="false">
            <OtelExportSizeCapFilter maxBytes="204800" onMatch="DENY" onMismatch="NEUTRAL"/>
            <RegexFilter regex="(?s).*\\|[-]{5,}\\|.*" onMatch="DENY" onMismatch="NEUTRAL"/>
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SqlAppender"/>
        </Logger>
        <Logger name="jdbc.audit" level="warn" additivity="false">
            <AppenderRef ref="SqlAppender"/>
        </Logger>
        <Logger name="jdbc.resultset" level="warn" additivity="false">
            <AppenderRef ref="SqlAppender"/>
        </Logger>
        <Logger name="jdbc.resultsettable" level="OFF" additivity="false" />
        <Logger name="jdbc.connection" level="warn" additivity="false">
            <AppenderRef ref="SqlAppender"/>
        </Logger>
        
        <Logger name="org.hibernate" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="org.hibernate.SQL" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        
        <Logger name="org.apache.coyote" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="org.apache.catalina" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Logger name="org.apache.tomcat" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
    </Loggers>
</Configuration>
