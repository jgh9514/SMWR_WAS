<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
	<settings>
		<setting name="mapUnderscoreToCamelCase" value="true" />
		<setting name="jdbcTypeForNull" value="NULL" />
		<!--
		  코어 SQL 로그(==> Preparing/Parameters) 비활성 — MybatisInterceptor 의 SQL(inlined)·log4jdbc 와 중복 방지.
		  쿼리 확인: smw.mybatis.log.inline-sql=true 및 log4jdbc(jdbc.sqltiming 등)
		-->
		<setting name="logImpl" value="org.apache.ibatis.logging.nologging.NoLoggingImpl" />
	</settings>
	<typeAliases>
		<typeAlias alias="sqlMap" type="java.util.HashMap" />
	</typeAliases>
</configuration>
